table 'rpt fact_qa_check'
	lineageTag: 1cb533f1-9d91-55e8-a23e-89470513060b

	measure 'Checklist Item Fail %' = DIVIDE ( CALCULATE ( COUNTROWS ( 'rpt fact_qa_check' ), KEEPFILTERS ( 'rpt fact_qa_check'[passed] = 0 ) ), COUNTROWS ( 'rpt fact_qa_check' ) )
