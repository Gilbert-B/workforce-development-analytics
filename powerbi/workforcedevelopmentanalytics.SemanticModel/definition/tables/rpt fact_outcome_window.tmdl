table 'rpt fact_outcome_window'
	lineageTag: aaa09b73-4d43-5c8a-9027-26f97b78c958

	measure 'Complete Windows' = COALESCE ( SUM ( 'rpt fact_outcome_window'[is_complete] ), 0 )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 9c9a71f3-5b7a-5cfe-ba9a-28f3e13528ee

	measure 'Window SLA Met %' = ```
			-- complete windows only: metrics of incomplete windows are blank by design
			DIVIDE ( SUM ( 'rpt fact_outcome_window'[sla_met_cases] ), SUM ( 'rpt fact_outcome_window'[cases_resolved] ) )
			```
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 9d20cd5d-e86d-5060-9f1d-52090d4404cf

	measure 'Window First-Time-Right %' = DIVIDE ( SUM ( 'rpt fact_outcome_window'[first_time_right_cases] ), SUM ( 'rpt fact_outcome_window'[cases_resolved] ) )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: d5e5aea0-183e-5c74-ad94-f04bd8d10ede

	measure 'Window QA Pass %' = DIVIDE ( SUM ( 'rpt fact_outcome_window'[qa_passed] ), SUM ( 'rpt fact_outcome_window'[qa_reviews] ) )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: db235a4e-c3d1-5e2e-abdd-0914da61b3fa

	measure 'Window Resolved per Agent-Day' = DIVIDE ( SUM ( 'rpt fact_outcome_window'[resolved_on_agent_days] ), SUM ( 'rpt fact_outcome_window'[agent_days] ) )
		formatString: 0.00
		displayFolder: Outcomes
		lineageTag: 4fe2585f-dd09-5bc3-b6d9-f8a1b9c09c0b

	measure 'Window Proficient %' = DIVIDE ( SUM ( 'rpt fact_outcome_window'[is_proficient] ), COUNT ( 'rpt fact_outcome_window'[is_proficient] ) )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: ea62ddc1-7513-5c2f-b1e4-05c3bb25bc3f

	measure 'Window SLA Gap vs Tenured (pts)' = ([Window SLA Met %] - [SLA Met % (Tenured Benchmark)]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Outcomes
		lineageTag: 15dcca15-8b0e-583c-83f9-007c006dfa9f

	measure 'Window FTR Gap vs Tenured (pts)' = ([Window First-Time-Right %] - [First-Time-Right % (Tenured Benchmark)]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Outcomes
		lineageTag: 0f8b8410-189c-547f-a562-20cafef45038

