table 'rpt fact_watchlist_case'
	lineageTag: 3084ffa0-b30e-4338-8487-a6c7ed529b2b

	measure 'Open Watch-list Enrolments (Snapshot)' = ```
			-- distinct ENROLMENTS with a case open at the snapshot (2 episodes = 1)
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( 'rpt fact_watchlist_case'[enrolment_id] ),
			        'rpt fact_watchlist_case'[is_open_at_snapshot] = 1
			    ),
			    0
			)
			```
		formatString: 0
		displayFolder: Watch-list & Coaching
		lineageTag: 4b4d9b5f-77d4-4805-bb55-0bec2c318e62

	measure 'Watch-list Rate (Snapshot)' = ```
			-- open watch-listed ACTIVE enrolments / active enrolments in the current filter
			DIVIDE (
			    CALCULATE (
			        [Open Watch-list Enrolments (Snapshot)],
			        KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Active" )
			    ),
			    CALCULATE (
			        COUNTROWS ( 'rpt dim_enrolment' ),
			        KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Active" )   -- respects a status selection
			    )
			)
			```
		formatString: 0.0%
		displayFolder: Watch-list & Coaching
		lineageTag: 61ef4403-c424-4a7f-9e06-54138ea4a3da

	measure 'Watch-list Cases' = ```
			-- cases (episodes), not people
			COALESCE ( COUNTROWS ( 'rpt fact_watchlist_case' ), 0 )
			```
		formatString: 0
		displayFolder: Watch-list & Coaching
		lineageTag: e4cbc8cc-0d8e-4f9d-89fe-e46bdfe49438

	measure 'Unactioned Watch-list Cases' = ```
			COALESCE (
			    CALCULATE ( COUNTROWS ( 'rpt fact_watchlist_case' ), 'rpt fact_watchlist_case'[has_action] = 0 ),
			    0
			)
			```
		formatString: 0
		displayFolder: Watch-list & Coaching
		lineageTag: 334af406-da62-4344-9351-ece919dd1e5f

	measure 'Coaching Coverage' = ```
			-- cases with >= 1 completed action / ALL cases (approved option A)
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'rpt fact_watchlist_case' ), 'rpt fact_watchlist_case'[has_action] = 1 ),
			    COUNTROWS ( 'rpt fact_watchlist_case' )
			)
			```
		formatString: 0.0%
		displayFolder: Watch-list & Coaching
		lineageTag: 1850c501-ef13-4d17-bc5a-d00110cfda4c

