table 'rpt fact_agent_day'
	lineageTag: c9008c3f-70a2-5360-abe9-1eb115c3182f

	measure 'Agent-Days Worked' = COALESCE ( COUNTROWS ( 'rpt fact_agent_day' ), 0 )
		formatString: #,0
		displayFolder: Agents
		lineageTag: 14b75d9d-e2e7-558a-acce-c956920dbf3a

	measure 'Resolved per Agent-Day' = DIVIDE ( SUM ( 'rpt fact_agent_day'[cases_resolved] ), COUNTROWS ( 'rpt fact_agent_day' ) )
		formatString: 0.00
		displayFolder: Agents
		lineageTag: 093ae826-6ac1-507a-8832-5a2472511a61

