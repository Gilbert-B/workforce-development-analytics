table 'rpt fact_certification_attempt'
	lineageTag: 9f8175df-c423-4286-aaa1-f9737f17da22

	measure 'Certification Attempts' = ```
			-- attempts (rows), not people
			COALESCE ( COUNTROWS ( 'rpt fact_certification_attempt' ), 0 )
			```
		formatString: 0
		displayFolder: Certification
		lineageTag: 76a22428-d09c-42b9-aecf-cca30f8a2ebb

	measure 'Certification Candidate Pass Rate' = ```
			VAR Pairs =                       -- one row per enrolment x certification ATTEMPTED
			    SUMMARIZE ( 'rpt fact_certification_attempt', 'rpt fact_certification_attempt'[enrolment_id], 'rpt fact_certification_attempt'[certification_id] )
			VAR PassedPairs =                 -- passed on ANY attempt: a retake counts once
			    FILTER ( Pairs, CALCULATE ( MAX ( 'rpt fact_certification_attempt'[is_passed] ) ) = 1 )
			RETURN
			    DIVIDE ( COUNTROWS ( PassedPairs ), COUNTROWS ( Pairs ) )
			```
		formatString: 0.0%
		displayFolder: Certification
		lineageTag: 6bd36efe-8eb7-4efc-bf84-0acca7d9eea8

	measure 'First-Attempt Pass Rate' = ```
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'rpt fact_certification_attempt' ), 'rpt fact_certification_attempt'[attempt_number] = 1, 'rpt fact_certification_attempt'[result] = "Passed" ),
			    CALCULATE ( COUNTROWS ( 'rpt fact_certification_attempt' ), 'rpt fact_certification_attempt'[attempt_number] = 1 )
			)
			```
		formatString: 0.0%
		displayFolder: Certification
		lineageTag: 3e081594-d680-4c04-9b72-b9d5c3ebfdb5

	measure 'Mandatory Certifications Met' = ```
			-- completed enrolments that passed EVERY mandatory certification
			VAR MandatoryCount =
			    CALCULATE ( COUNTROWS ( 'rpt dim_certification' ),
			                REMOVEFILTERS ( 'rpt dim_certification' ),
			                'rpt dim_certification'[mandatory_for_readiness] = TRUE () )
			VAR CompletedEnrolments =
			    CALCULATETABLE ( VALUES ( 'rpt dim_enrolment'[enrolment_id] ),
			                     KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) )
			RETURN
			COALESCE (
			    COUNTROWS (
			        FILTER ( CompletedEnrolments,
			            CALCULATE ( DISTINCTCOUNT ( 'rpt fact_certification_attempt'[certification_id] ),
			                        'rpt fact_certification_attempt'[is_passed] = 1,
			                        REMOVEFILTERS ( 'rpt dim_certification' ),
			                        'rpt dim_certification'[mandatory_for_readiness] = TRUE () )
			                = MandatoryCount ) ),
			    0
			)
			```
		formatString: 0
		displayFolder: Certification
		lineageTag: 19403bf9-539a-4ccd-a3c3-6d7d58817cce

	measure 'Unattempted Certification Opportunities' = ```
			-- completed enrolment x mandatory certification pairs with NO attempt
			VAR MandatoryCount =
			    CALCULATE ( COUNTROWS ( 'rpt dim_certification' ),
			                REMOVEFILTERS ( 'rpt dim_certification' ),
			                'rpt dim_certification'[mandatory_for_readiness] = TRUE () )
			VAR AttemptedPairs =
			    CALCULATE (
			        COUNTROWS ( SUMMARIZE ( 'rpt fact_certification_attempt', 'rpt fact_certification_attempt'[enrolment_id], 'rpt fact_certification_attempt'[certification_id] ) ),
			        KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ),
			        REMOVEFILTERS ( 'rpt dim_certification' ),
			        'rpt dim_certification'[mandatory_for_readiness] = TRUE ()
			    )
			VAR CompletedInContext =
			    CALCULATE ( COUNTROWS ( 'rpt dim_enrolment' ),
			                KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) )
			RETURN
			    COALESCE ( CompletedInContext, 0 ) * MandatoryCount - COALESCE ( AttemptedPairs, 0 )
			```
		formatString: 0
		displayFolder: Certification
		lineageTag: 7c8e599f-b8a0-4339-9391-53b8f223c30f

	measure 'Completers With No Certification Attempt' = ```
			VAR CompletedEnrolments =
			    CALCULATETABLE ( VALUES ( 'rpt dim_enrolment'[enrolment_id] ),
			                     KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) )
			RETURN
			COALESCE (
			    COUNTROWS ( FILTER ( CompletedEnrolments,
			                         ISBLANK ( CALCULATE ( COUNTROWS ( 'rpt fact_certification_attempt' ),
			                                               -- "no attempt at ANY certification": a certification
			                                               -- selection must not change the meaning
			                                               REMOVEFILTERS ( 'rpt dim_certification' ),
			                                               REMOVEFILTERS ( 'rpt fact_certification_attempt'[certification_id] ) ) ) ) ),
			    0
			)
			```
		formatString: 0
		displayFolder: Certification
		lineageTag: aa520a01-5e79-41ba-8254-2982d0cd46bb

