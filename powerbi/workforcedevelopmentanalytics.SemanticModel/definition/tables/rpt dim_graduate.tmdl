table 'rpt dim_graduate'
	lineageTag: bb086fcf-b51c-5e32-81eb-81386babb902

	measure 'Graduates Deployed' = COALESCE ( COUNTROWS ( 'rpt dim_graduate' ), 0 )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 4f25145e-fbdd-5f51-b42a-5a9c66c3db63

	measure '90-Day Retention %' = ```
			-- graduates still employed at day 90 / graduates who have reached day 90 (observed periods only)
			DIVIDE ( SUM ( 'rpt dim_graduate'[retained_90_days] ), COUNT ( 'rpt dim_graduate'[retained_90_days] ) )
			```
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 18095221-cc53-5c17-a241-a62a54308dc0

	measure 'Graduates Left Before Day 90' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[retained_90_days] = 0 ) ), 0 )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: c1d1624d-8c93-5d88-9a31-ce3c3bb9baf6

	measure 'Proficient by Day 90 %' = ```
			-- of graduates still employed at day 90: reached the proficiency standard in any window
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[retained_90_days] = 1 ),
			                KEEPFILTERS ( NOT ISBLANK ( 'rpt dim_graduate'[days_to_proficiency] ) ) ),
			    CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[retained_90_days] = 1 ) ) )
			```
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 67ff313a-cc16-53c8-aef1-2e5bfb3edbae

	measure 'Proficient by Day 30 %' = ```
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[days_to_proficiency] = 30 ) ),
			    CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[proficiency_status] <> "Too early to tell" ) ) )
			```
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: d3e0690a-c5ac-5027-bd4d-cd46cb24672d

	measure 'Avg Days to Proficiency' = ```
			-- proficient graduates only; measured in 30-day windows, so 30 / 60 / 90
			AVERAGE ( 'rpt dim_graduate'[days_to_proficiency] )
			```
		formatString: 0
		displayFolder: Outcomes
		lineageTag: 0e7c24bd-8205-5f5b-a7ff-95fa670b59e1

	measure 'Avg Final Competency' = AVERAGE ( 'rpt dim_graduate'[final_competency_score] )
		formatString: 0.0
		displayFolder: Outcomes
		lineageTag: 00ba5b63-f78a-51c5-a721-c2575f99ac8b

	measure 'Certified First Attempt %' = ```
			DIVIDE ( CALCULATE ( COUNTROWS ( 'rpt dim_graduate' ), KEEPFILTERS ( 'rpt dim_graduate'[certified_first_attempt] = "Yes" ) ),
			         COUNTROWS ( 'rpt dim_graduate' ) )
			```
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 5f900968-026d-5580-9a11-8d767d27a3b0

	measure 'Graduate Title' = ```
			IF ( HASONEVALUE ( 'rpt dim_graduate'[agent_id] ),
			    SELECTEDVALUE ( 'rpt dim_graduate'[graduate_name] ) & "  ·  " & SELECTEDVALUE ( 'rpt dim_graduate'[cohort_name] ),
			    "Drill through from any graduate to open their journey" )
			```
		displayFolder: Outcomes
		lineageTag: 2c585970-4654-572f-8df8-8081146faf59

	measure 'Graduate Journey Label' = ```
			IF ( HASONEVALUE ( 'rpt dim_graduate'[agent_id] ),
			    "Final competency " & FORMAT ( SELECTEDVALUE ( 'rpt dim_graduate'[final_competency_score] ), "0.0" )
			    & " (" & SELECTEDVALUE ( 'rpt dim_graduate'[competency_band] ) & ")"
			    & " · certified first attempt: " & SELECTEDVALUE ( 'rpt dim_graduate'[certified_first_attempt] )
			    & " · watch list: " & SELECTEDVALUE ( 'rpt dim_graduate'[watchlisted_in_training] )
			    & " · deployed " & FORMAT ( SELECTEDVALUE ( 'rpt dim_graduate'[deployment_date] ), "d mmm yyyy" )
			    & " · " & SELECTEDVALUE ( 'rpt dim_graduate'[proficiency_status] ),
			    "" )
			```
		displayFolder: Outcomes
		lineageTag: f877ba54-51f1-5dbe-9c9c-d8641517026e

