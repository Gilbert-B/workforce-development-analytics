table 'rpt fact_qa_review'
	lineageTag: 24931f43-5231-5693-b535-53bc970e1430

	measure 'QA Reviews' = COALESCE ( COUNTROWS ( 'rpt fact_qa_review' ), 0 )
		formatString: #,0
		displayFolder: Quality
		lineageTag: 79cb575c-2ec4-5ab6-b3a2-c1cea9dbc46c

	measure 'QA Pass %' = DIVIDE ( SUM ( 'rpt fact_qa_review'[passed] ), COUNTROWS ( 'rpt fact_qa_review' ) )
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 03e6dd7c-47cf-5a66-9a88-0c6d598ca900

	measure 'QA Pass % (Tenured Benchmark)' = ```
			CALCULATE ( [QA Pass %],
			    REMOVEFILTERS ( 'rpt dim_agent' ), REMOVEFILTERS ( 'rpt dim_graduate' ),
			    REMOVEFILTERS ( 'rpt fact_qa_review'[tenure_band], 'rpt fact_qa_review'[tenure_band_order] ),
			    'rpt fact_qa_review'[tenure_band] = "Tenured" )
			```
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 0629bb6b-dd6e-56cb-9278-460337a8b128

	measure 'Avg QA Score' = AVERAGE ( 'rpt fact_qa_review'[score] )
		formatString: 0.0
		displayFolder: Quality
		lineageTag: 20998742-6652-5e26-b264-799e1e6e35d5

	measure 'QA Critical Error %' = DIVIDE ( SUM ( 'rpt fact_qa_review'[has_critical_error] ), COUNTROWS ( 'rpt fact_qa_review' ) )
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 7985aafa-274e-5184-ab52-0867d356ef3a

