table 'rpt fact_readiness_review'
	lineageTag: 35be8527-5770-467a-aa60-baaee6e07d4e

	measure 'Reviewed for Readiness' = ```
			-- completed enrolments with >= 1 review
			COALESCE (
			    CALCULATE ( DISTINCTCOUNT ( 'rpt fact_readiness_review'[enrolment_id] ),
			                KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) ),
			    0
			)
			```
		formatString: 0
		displayFolder: Readiness
		lineageTag: 1e2c4b96-855c-4ade-9022-fcc8314769d7

	measure 'Unreviewed Completers' = ```
			-- completed, no review yet: NOT deferred, NOT failed
			VAR CompletedInContext =
			    CALCULATE ( COUNTROWS ( 'rpt dim_enrolment' ),
			                KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) )
			RETURN
			    COALESCE ( CompletedInContext, 0 ) - [Reviewed for Readiness]
			```
		formatString: 0
		displayFolder: Readiness
		lineageTag: b421ab84-aec3-4fe6-80e2-1c9e0508988a

	measure 'Ready / Approved (Snapshot)' = ```
			-- LATEST review per enrolment = Approved (a superseded approval never counts)
			COALESCE (
			    CALCULATE ( DISTINCTCOUNT ( 'rpt fact_readiness_review'[enrolment_id] ),
			                'rpt fact_readiness_review'[is_latest_review] = 1,
			                'rpt fact_readiness_review'[decision] = "Approved",
			                KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) ),
			    0
			)
			```
		formatString: 0
		displayFolder: Readiness
		lineageTag: 2e44d0fc-c95d-475a-a98b-798f28961199

	measure 'Readiness Approval Rate' = ```
			-- approved / latest-reviewed completers
			DIVIDE ( [Ready / Approved (Snapshot)], [Reviewed for Readiness] )
			```
		formatString: 0.0%
		displayFolder: Readiness
		lineageTag: 7ab4ed59-12f0-4cd4-b1e0-fed8f8bedfa8

	measure 'Readiness Coverage' = ```
			-- approved / ALL completers in the current filter
			DIVIDE (
			    [Ready / Approved (Snapshot)],
			    CALCULATE ( COUNTROWS ( 'rpt dim_enrolment' ),
			                KEEPFILTERS ( 'rpt dim_enrolment'[status_as_of_snapshot] = "Completed" ) )
			)
			```
		formatString: 0.0%
		displayFolder: Readiness
		lineageTag: b301470c-8c7e-4fe6-b506-7255180c5d6b

	measure 'Readiness Status Label' = ```
			-- Trainee 360 badge for ONE enrolment; never says "Failed"
			IF (
			    HASONEVALUE ( 'rpt dim_enrolment'[enrolment_id] ),
			    VAR Status = SELECTEDVALUE ( 'rpt dim_enrolment'[status_as_of_snapshot] )
			    VAR Latest =
			        CALCULATE ( SELECTEDVALUE ( 'rpt fact_readiness_review'[decision] ), 'rpt fact_readiness_review'[is_latest_review] = 1 )
			    VAR Reason =
			        CALCULATE ( SELECTEDVALUE ( 'rpt fact_readiness_review'[decision_reason_code] ), 'rpt fact_readiness_review'[is_latest_review] = 1 )
			    RETURN
			        SWITCH ( TRUE (),
			            Status = "Active", "Not yet eligible: training in progress",
			            Status <> "Completed", "Not eligible: enrolment ended (" & Status & ")",
			            ISBLANK ( Latest ), "Completed: not yet reviewed",
			            Latest = "Approved", "Approved for readiness (not deployment)",
			            "Deferred: " & Reason ),
			    ""
			)
			```
		displayFolder: Readiness
		lineageTag: ecd69508-b049-4171-9c85-552bcc59d063

