table 'rpt fact_payment_case'
	lineageTag: 4c52ac79-d929-5128-b2bf-71a171c6b208

	measure 'Cases Received' = COALESCE ( COUNTROWS ( 'rpt fact_payment_case' ), 0 )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 741ba322-f52d-53d7-a1df-6d81c47edf65

	measure 'Cases Resolved' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt fact_payment_case' ), KEEPFILTERS ( 'rpt fact_payment_case'[is_open] = 0 ) ), 0 )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 3bbac9a7-f939-5279-b115-dad65db937d6

	measure 'Open Cases (Snapshot)' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt fact_payment_case' ), KEEPFILTERS ( 'rpt fact_payment_case'[is_open] = 1 ) ), 0 )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 65c34be2-82a4-57ef-9a04-2848fe73793d

	measure 'Overdue Open Cases (Snapshot)' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt fact_payment_case' ), KEEPFILTERS ( 'rpt fact_payment_case'[is_overdue_open] = 1 ) ), 0 )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 642e58d8-b6fb-5dd0-9934-109efb5d2c68

	measure 'SLA Met %' = ```
			-- sla_met is blank for open cases; COUNT skips blanks, so the denominator is resolved cases only
			DIVIDE ( SUM ( 'rpt fact_payment_case'[sla_met] ), COUNT ( 'rpt fact_payment_case'[sla_met] ) )
			```
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 4152978c-9a21-5a41-a76d-29e8de16da60

	measure 'SLA Met % (Tenured Benchmark)' = ```
			-- tenured agents' SLA met % in the same queue / date / priority context
			CALCULATE ( [SLA Met %],
			    REMOVEFILTERS ( 'rpt dim_agent' ), REMOVEFILTERS ( 'rpt dim_graduate' ),
			    REMOVEFILTERS ( 'rpt fact_payment_case'[tenure_band], 'rpt fact_payment_case'[tenure_band_order] ),
			    'rpt fact_payment_case'[tenure_band] = "Tenured" )
			```
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 003d60fd-ee88-54cf-ae95-186b7e766182

	measure 'SLA Gap vs Tenured (pts)' = ([SLA Met %] - [SLA Met % (Tenured Benchmark)]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Operations
		lineageTag: ee7e74dc-52b5-5092-89c9-509a7a5e4f1e

	measure 'First-Time-Right %' = DIVIDE ( SUM ( 'rpt fact_payment_case'[first_time_right] ), [Cases Resolved] )
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: f28f80ef-47e1-5bc4-b6d6-7f0544b2f347

	measure 'First-Time-Right % (Tenured Benchmark)' = ```
			CALCULATE ( [First-Time-Right %],
			    REMOVEFILTERS ( 'rpt dim_agent' ), REMOVEFILTERS ( 'rpt dim_graduate' ),
			    REMOVEFILTERS ( 'rpt fact_payment_case'[tenure_band], 'rpt fact_payment_case'[tenure_band_order] ),
			    'rpt fact_payment_case'[tenure_band] = "Tenured" )
			```
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: fd9edec4-c1b0-52bf-9e5c-27df33affd93

	measure 'Reworked Cases' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt fact_payment_case' ), KEEPFILTERS ( 'rpt fact_payment_case'[has_rework] = 1 ) ), 0 )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 9055f1fa-a615-5647-92e0-e5a89655afa5

	measure 'Avg Resolution Hours' = AVERAGE ( 'rpt fact_payment_case'[final_resolution_hours] )
		formatString: 0.0
		displayFolder: Operations
		lineageTag: de71b4ec-f615-5b2a-82b8-9d2abe3614aa

	measure 'Median Resolution Hours' = MEDIAN ( 'rpt fact_payment_case'[final_resolution_hours] )
		formatString: 0.0
		displayFolder: Operations
		lineageTag: d376eb5b-3012-5722-805d-68aebc0ef2e8

	measure 'QA Sample Rate %' = ```
			-- share of RESOLVED cases picked for QA (both sides dated by received date)
			DIVIDE ( CALCULATE ( COUNTROWS ( 'rpt fact_payment_case' ), KEEPFILTERS ( 'rpt fact_payment_case'[qa_sampled] = 1 ) ), [Cases Resolved] )
			```
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 82db189b-5f33-5a43-92a7-3e92047708a5

