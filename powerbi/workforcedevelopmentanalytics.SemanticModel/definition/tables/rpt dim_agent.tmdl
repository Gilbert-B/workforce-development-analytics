	partition 'rpt dim_agent' = m
		mode: import
		source =
				let
				    Source = Sql.Databases("localhost"),
				    WorkforceDevAnalytics = Source{[Name="WorkforceDevAnalytics"]}[Data],
				    rpt_dim_agent = WorkforceDevAnalytics{[Schema="rpt",Item="dim_agent"]}[Data]
				in
				    rpt_dim_agent

	annotation PBI_ResultType = Table
