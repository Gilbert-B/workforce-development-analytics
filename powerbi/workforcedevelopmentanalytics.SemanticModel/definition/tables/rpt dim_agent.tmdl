table 'rpt dim_agent'
	lineageTag: 6b64cfb5-e65d-5110-a185-9c6a63d24329

	measure 'Active Agents (Snapshot)' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt dim_agent' ), KEEPFILTERS ( 'rpt dim_agent'[is_active_at_snapshot] = 1 ) ), 0 )
		formatString: #,0
		displayFolder: Agents
		lineageTag: 3eacc22a-11e7-5b2f-8028-403610cc4101

	measure 'Graduate Agents (Snapshot)' = ```
			COALESCE ( CALCULATE ( COUNTROWS ( 'rpt dim_agent' ), KEEPFILTERS ( 'rpt dim_agent'[is_active_at_snapshot] = 1 ),
			                       KEEPFILTERS ( 'rpt dim_agent'[agent_type] = "Graduate" ) ), 0 )
			```
		formatString: #,0
		displayFolder: Agents
		lineageTag: b51acaa3-9356-5c22-a4d6-226b6e77c353

	measure 'Agents Exited' = COALESCE ( CALCULATE ( COUNTROWS ( 'rpt dim_agent' ), KEEPFILTERS ( NOT ISBLANK ( 'rpt dim_agent'[exit_date] ) ) ), 0 )
		formatString: #,0
		displayFolder: Agents
		lineageTag: 9b876dd9-ff28-5470-bc03-3b79b6dbd7a0

	measure 'Agent Title' = ```
			-- Agent 360 header: one agent in context, else a prompt
			IF ( HASONEVALUE ( 'rpt dim_agent'[agent_id] ),
			    SELECTEDVALUE ( 'rpt dim_agent'[agent_name] ) & "  ·  " & SELECTEDVALUE ( 'rpt dim_agent'[agent_id] ),
			    "Drill through from any agent to open their profile" )
			```
		displayFolder: Agents
		lineageTag: 74659501-747c-560a-afc0-f526cf529f00

	measure 'Agent Profile Label' = ```
			IF ( HASONEVALUE ( 'rpt dim_agent'[agent_id] ),
			    VAR T = SELECTEDVALUE ( 'rpt dim_agent'[agent_type] )
			    VAR Started = FORMAT ( SELECTEDVALUE ( 'rpt dim_agent'[start_date] ), "d mmm yyyy" )
			    VAR ExitDate = SELECTEDVALUE ( 'rpt dim_agent'[exit_date] )
			    RETURN
			        T & " agent · " & SELECTEDVALUE ( 'rpt dim_agent'[team_name] ) & " · " & SELECTEDVALUE ( 'rpt dim_agent'[primary_queue_name] )
			        & " · started " & Started
			        & IF ( T = "Graduate", " · cohort " & SELECTEDVALUE ( 'rpt dim_agent'[cohort_id] ), "" )
			        & IF ( ISBLANK ( ExitDate ), "", " · left " & FORMAT ( ExitDate, "d mmm yyyy" ) ),
			    "" )
			```
		displayFolder: Agents
		lineageTag: 59f27829-fe56-5f2e-b48e-57a6c519a03d

