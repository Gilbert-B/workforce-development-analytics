	partition 'rpt dim_competency' = m
		mode: import
		source =
				let
				    Source = Sql.Databases("localhost"),
				    WorkforceDevAnalytics = Source{[Name="WorkforceDevAnalytics"]}[Data],
				    rpt_dim_competency = WorkforceDevAnalytics{[Schema="rpt",Item="dim_competency"]}[Data]
