    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Windows and the honest-window rule",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Days 1-30, 31-60 and 61-90 after the graduate's first day in operations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  A window counts only if it ended by the snapshot AND the graduate was still employed at its end.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Otherwise it is 'Not yet reached' or 'Left before window end' and its metrics are blank: an exit never becomes a zero-performance month.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Retention uses observed employment periods only.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
