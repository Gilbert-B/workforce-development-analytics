    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the data says",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Training predicts early performance, but only moderately: 24% of the top third by final competency met the standard in their first 30 days, against 8% of the bottom third.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  By day 90 most of the bottom third had caught up (72% proficient).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Passing both certifications first time goes with a faster start: 16% proficient by day 30, against 9%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Trainees who were on the watch list were more likely to leave: 90.5% still employed at day 90, against 96.6%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Individual variation is large: a training score is a reason to support someone, not a verdict.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Associations, not causes. Figures: all graduates, no filters.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#5E5A73"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
