    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "•  Training results predict early performance, but only moderately: 24% of the top third by final competency met the standard in their first 30 days, against 8% of the bottom third. By day 90 most of the bottom third had caught up (72%).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Passing both certifications at the first attempt goes with a faster start: 16% proficient by day 30, against 9%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Trainees who were on the watch list were more likely to leave: 90.5% still employed at day 90, against 96.6%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Individual variation is large: a training score is a reason to support someone, not a verdict.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#17132B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Associations, not causes: the academy did not run an experiment. Figures: all graduates, no filters.",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#5E5A73"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
