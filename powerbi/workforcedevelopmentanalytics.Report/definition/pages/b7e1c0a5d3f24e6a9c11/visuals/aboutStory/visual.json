                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What this page set shows",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "15pt",
                      "color": "#F6F0E4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Overview: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#F6F0E4"
                    }
                  },
                  {
                    "value": "headcount, training status, attendance quality and weekly competency progression, with cohort selection, bookmarked views and an on-page definitions drawer.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cohorts, Skills, Attendance, Trainee 360: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#F6F0E4"
                    }
                  },
                  {
                    "value": "planned for later builds.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rules that keep the numbers honest",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "15pt",
                      "color": "#F6F0E4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Status is calculated from dated lifecycle events, not overwritten flags.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Unrecorded attendance is shown separately and never counted as absent.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Cohorts are compared by programme week; weeks not yet reached are blank, not zero.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The snapshot date comes from the data itself and updates on refresh.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C4CDD8"
                    }
