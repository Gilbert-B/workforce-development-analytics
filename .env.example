# Settings read by python/load_to_sql.py from ENVIRONMENT VARIABLES.
# The script does not read .env files itself: set them in your shell, e.g.
#   PowerShell:  $env:WDA_SQL_SERVER = "localhost\SQLEXPRESS"
# (--server on the command line works too.) Windows login needs no password.
# Never commit real passwords; .env is git-ignored if you keep one locally.

# SQL Server instance, e.g. localhost\SQLEXPRESS (Express) or localhost (default instance)
WDA_SQL_SERVER=localhost\SQLEXPRESS

# Only for a SQL login instead of Windows authentication:
# WDA_SQL_USER=
# WDA_SQL_PASSWORD=

# Optional: force a specific ODBC driver
# WDA_SQL_DRIVER=ODBC Driver 18 for SQL Server
